# ==============================================================================
# SMRKOMED (DAYA HOSPITAL) — AI VOICE SAAS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit production API keys, secrets, or credentials to git.
# All variables below are server-side only; do NOT prefix with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGRESQL PRISMA
# ------------------------------------------------------------------------------
# PostgreSQL database connection string. Leave unset for in-memory demo sandbox.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daya_ai_calling?schema=public"

# ------------------------------------------------------------------------------
# 2. EXOTEL CLOUD TELEPHONY & AGENTSTREAM INTEGRATION
# ------------------------------------------------------------------------------
# Primary Telephony Provider identifier (EXOTEL or BITVOICE)
TELEPHONY_PROVIDER="EXOTEL"

# Exotel Account SID (found on your Exotel API console)
EXOTEL_ACCOUNT_SID="your_exotel_account_sid"

# Exotel API Key (used as HTTP Basic Auth username)
EXOTEL_API_KEY="your_exotel_api_key"

# Exotel API Token (used as HTTP Basic Auth password)
EXOTEL_API_TOKEN="your_exotel_api_token"

# Exotel API Base URL (defaults to https://api.exotel.com/v1/Accounts/<EXOTEL_ACCOUNT_SID>)
EXOTEL_BASE_URL="https://api.exotel.com/v1/Accounts/your_exotel_account_sid"

# Exotel Regional Subdomain (defaults to "api", or customer-assigned subdomain)
EXOTEL_SUBDOMAIN="api"

# Deployed Voicebot / AgentStream Applet ID in Exotel Flow Builder
EXOTEL_DEFAULT_APP_ID="app_daya_voicebot_v1"

# Primary Virtual ExoPhone allocated by Exotel for inbound and outbound calls
EXOTEL_DEFAULT_EXOPHONE="+914872475000"

# Exotel Webhook Secret (for verifying incoming StatusCallback & Passthru webhooks)
EXOTEL_WEBHOOK_SECRET="whsec_exotel_daya_secret_2026"

# Exotel StatusCallback URL (endpoint to receive call completion & status updates)
EXOTEL_STATUS_CALLBACK_URL="https://daya.smrkomed.com/api/webhooks/exotel"

# Total concurrent virtual channels (PRI trunk channels)
TELEPHONY_TRUNK_CHANNELS="30"

# Fallback Extension: Emergency Casualty & Trauma desk (24/7 coverage)
TELEPHONY_FALLBACK_EXTENSION="101"

# Secondary Human Agent Extensions (comma-separated hunt group)
TELEPHONY_AGENT_EXTENSIONS="201,202,203,204,205,206"

# Front desk ring timeout before rollover to AI (default: 20s)
TELEPHONY_ROLLOVER_TIMEOUT_SECONDS="20"

# ------------------------------------------------------------------------------
# 3. SMRKOMED REAL-TIME AUDIO MEDIA GATEWAY (WEBSOCKETS)
# ------------------------------------------------------------------------------
# Publicly accessible secure WebSocket URL for Exotel AgentStream to connect to
VOICE_GATEWAY_PUBLIC_URL="wss://voice.smrkomed.com/exotel/voicebot"

# Media Gateway listening port for container deployment
VOICE_GATEWAY_PORT="8080"
VOICE_GATEWAY_HOST="0.0.0.0"

# Optional shared secret for authenticating WebSocket connections from Exotel Applet
VOICE_GATEWAY_AUTH_SECRET="gateway_auth_token_sample"

# ------------------------------------------------------------------------------
# 4. SARVAM AI VOICE & TELEPHONY SUITE (STREAMING STT, TTS & SAMVAAD)
# ------------------------------------------------------------------------------
# Primary Sarvam AI REST and WebSocket API Key (bulbul TTS & saaras STT)
SARVAM_API_KEY="sk_sarvam_live_sample_placeholder"

# Sarvam Samvaad Telephony Suite API Key
SARVAM_SAMVAAD_API_KEY="sk_samvaad_sample_placeholder"

# Sarvam Organization and Workspace Identifiers
SARVAM_ORG_ID="your_sarvam_org_uuid"
SARVAM_WORKSPACE_ID="your_sarvam_workspace_uuid"

# Sarvam Voicebot Application ID & Version
SARVAM_APP_ID="smrkomed-voicebot-app-id"
SARVAM_APP_VERSION="8"

# Sarvam Telephony Connection ID
SARVAM_CONNECTION_ID="your_sarvam_connection_uuid"

# Sarvam Allocated Virtual Agent Phone Number
SARVAM_AGENT_PHONE_NUMBER="+918064265889"

# Base URL for Sarvam API (defaults to https://api.sarvam.ai)
SARVAM_BASE_URL="https://api.sarvam.ai"

# Legacy Agent / Deployment ID
SARVAM_AGENT_ID="agent_sarvam_malayalam_dgh_v1"

# Webhook signature secret used for HMAC-SHA256 timing-safe verification
SARVAM_WEBHOOK_SECRET="whsec_sarvam_daya_sample_secret_2026"

# ------------------------------------------------------------------------------
# 5. DAYA HOSPITAL MANAGEMENT SYSTEM (HMS) INTEGRATION
# ------------------------------------------------------------------------------
# Internal Daya Hospital Core HMS API gateway URL
DAYA_HMS_BASE_URL="https://hms-api.dayahospital.internal"

# HMS API client authentication token
DAYA_HMS_API_KEY="daya_hms_token_sample_secret"

# HMS Gateway timeout threshold in milliseconds (default: 3000ms)
DAYA_HMS_TIMEOUT_MS="3000"

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# NextAuth / session encryption secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="sample_session_encryption_secret_daya_hospital"
NEXTAUTH_URL="http://localhost:3000"
