datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  HOSPITAL_ADMIN
  HOSPITAL_STAFF
  CALL_REVIEWER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
}

enum CallStatus {
  ANSWERED
  BUSY
  MISSED
  TRANSFERRED
  FAILED
  COMPLETED
}

enum CallSource {
  IVR_ROLLOVER
  DIRECT_HOTLINE
  OFF_HOURS
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallLanguage {
  MALAYALAM
  MANGLISH
  ENGLISH
}

enum IntentCategory {
  APPOINTMENT_BOOKING
  DOCTOR_AVAILABILITY
  DEPARTMENT_ENQUIRY
  CONSULTATION_FEES
  HOSPITAL_TIMINGS
  EMERGENCY_AMBULANCE
  INSURANCE_TPA
  GENERAL_QUERY
}

enum FollowUpStatus {
  NOT_REQUIRED
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum ActionType {
  CHECK_DOCTOR_SLOT
  BOOK_APPOINTMENT
  RESCHEDULE_APPOINTMENT
  CANCEL_APPOINTMENT
  TRANSFER_CALL_TO_STAFF
  FEE_ENQUIRY
  DEPARTMENT_ROUTING
  GENERAL_ASSISTANCE
}

enum ActionStatus {
  REQUESTED
  IN_PROGRESS
  CONFIRMED
  FAILED
  PENDING_VERIFICATION
  REQUIRES_STAFF_FOLLOW_UP
  CANCELLED
}

enum KnowledgeStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

enum IntegrationHealth {
  HEALTHY
  DEGRADED
  DOWN
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

enum PriorityLevel {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum StaffPresenceStatus {
  AVAILABLE
  RINGING
  ON_CALL
  WRAP_UP
  BREAK
  OFFLINE
}

// ----------------------------------------------------
// 1. USERS & ROLES
// ----------------------------------------------------

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  name                String
  passwordHash        String
  role                UserRole         @default(CALL_REVIEWER)
  status              UserStatus       @default(ACTIVE)
  department          String
  employeeId          String?          @unique
  phone               String?
  canAccessRecordings Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  lastLoginAt         DateTime?

  auditLogs           AuditLog[]
  assignedFollowUps   FollowUpTask[]
  rolePermissions     RolePermission[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model RolePermission {
  id        String   @id @default(cuid())
  role      UserRole
  resource  String   // CALLS, RECORDINGS, KNOWLEDGE_BASE, USERS, SETTINGS, AUDIT_LOGS, METRICS
  action    String   // READ, WRITE, DELETE, PUBLISH, EXPORT
  isAllowed Boolean  @default(true)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([role, resource, action])
  @@index([role])
}

// ----------------------------------------------------
// 2. CALLS & TRANSCRIPTS & RECORDINGS
// ----------------------------------------------------

model CallRecord {
  id                 String             @id
  externalCallId     String?            @unique // External Sarvam interaction ID
  telephonySessionId String?            @unique // External IVR SIP session ID
  callerNumber       String             // Masked: +91 94471 •••••
  callerName         String?
  patientUhid        String?
  startTime          DateTime
  endTime            DateTime?
  durationSeconds    Int                @default(0)
  callStatus         CallStatus         @default(ANSWERED)
  callSource         CallSource         @default(IVR_ROLLOVER)
  language           CallLanguage       @default(MALAYALAM)
  intentCategory     IntentCategory     @default(GENERAL_QUERY)
  aiSummary          String
  aiConfidence       Float              @default(0.95)
  requiresFollowUp   Boolean            @default(false)
  followUpStatus     FollowUpStatus     @default(NOT_REQUIRED)
  followUpNotes      String?
  assignedStaff      String?
  hmsTransactionRef  String?
  isReviewed         Boolean            @default(false)
  reviewedBy         String?
  reviewedAt         DateTime?
  hospitalId         String             @default("hosp_daya_thrissur")
  provider           String             @default("EXOTEL")
  direction          CallDirection      @default(INBOUND)
  telephonyAccountSid String?
  streamSid          String?
  fromNumber         String?
  toNumber           String?
  failureReason      String?
  recordingSid       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  transcriptEntries  TranscriptEntry[]
  recordingMetadata  RecordingMetadata?
  actions            AiAction[]
  followUpTasks      FollowUpTask[]

  @@index([callerNumber])
  @@index([callStatus])
  @@index([intentCategory])
  @@index([language])
  @@index([startTime])
  @@index([requiresFollowUp])
  @@index([hospitalId])
  @@index([direction])
  @@index([streamSid])
}

model TranscriptEntry {
  id            String     @id @default(cuid())
  callId        String
  speaker       String     // AI_AGENT, CALLER, STAFF
  text          String
  textMalayalam String?
  timestampMs   Int
  confidence    Float?
  sentiment     String?
  createdAt     DateTime   @default(now())

  call          CallRecord @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([timestampMs])
}

model RecordingMetadata {
  id                String     @id @default(cuid())
  callId            String     @unique
  externalSessionId String?
  storageKey        String?
  storageUrl        String?
  mimeType          String     @default("audio/webm;codecs=opus")
  durationSeconds   Int
  fileSizeBytes     Int?
  hasConsent        Boolean    @default(true)
  retentionExpiry   DateTime
  isArchived        Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  call              CallRecord @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([retentionExpiry])
}

// ----------------------------------------------------
// 3. AI ACTIONS & OUTCOME EVENTS
// ----------------------------------------------------

model AiAction {
  id                String         @id
  callId            String
  actionType        ActionType
  status            ActionStatus   @default(REQUESTED)
  idempotencyKey    String         @unique
  externalReference String?        // HMS booking reference or Sarvam action ID
  doctorName        String?
  department        String?
  appointmentSlot   String?
  patientUhid       String?
  patientName       String?
  failureReason     String?
  staffNotes        String?
  payloadJson       String?
  responseJson      String?
  requestedAt       DateTime       @default(now())
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  call              CallRecord     @relation(fields: [callId], references: [id], onDelete: Cascade)
  events            ActionEvent[]

  @@index([callId])
  @@index([status])
  @@index([actionType])
  @@index([idempotencyKey])
  @@index([requestedAt])
}

model ActionEvent {
  id              String   @id @default(cuid())
  actionId        String
  eventType       String   // SLOT_LOOKUP, PAYLOAD_SENT, HMS_CONFIRMED, VERIFICATION_FAILED
  status          String
  hmsResponseCode String?
  details         String?
  timestamp       DateTime @default(now())

  action          AiAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@index([timestamp])
}

// ----------------------------------------------------
// 4. CLINICAL FOLLOW-UP TASKS
// ----------------------------------------------------

model FollowUpTask {
  id           String         @id @default(cuid())
  callId       String
  callerNumber String
  callerName   String?
  reason       String
  priority     PriorityLevel  @default(NORMAL)
  status       FollowUpStatus @default(PENDING)
  assignedTo   String?
  assignedUser User?          @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  notes        String?
  dueAt        DateTime?
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  call         CallRecord     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([status])
  @@index([priority])
}

// ----------------------------------------------------
// 5. KNOWLEDGE ARTICLES & VERSION AUDIT
// ----------------------------------------------------

model KnowledgeArticle {
  id                        String             @id
  title                     String
  titleMalayalam            String?
  category                  String
  summary                   String
  content                   String
  contentMalayalam          String?
  sourceReference           String?
  internalNotes             String?
  status                    KnowledgeStatus    @default(DRAFT)
  version                   Int                @default(1)
  lastUpdatedBy             String
  lastPublishedAt           DateTime?
  lastPublishedBy           String?
  publishedContent          String?
  publishedContentMalayalam String?
  hasUnpublishedChanges     Boolean            @default(false)
  syncedToSarvam            Boolean            @default(false)
  lastSyncedAt              DateTime?
  isDemoData                Boolean            @default(false)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  versions                  KnowledgeVersion[]

  @@index([category])
  @@index([status])
  @@index([updatedAt])
}

model KnowledgeVersion {
  id               String           @id @default(cuid())
  articleId        String
  versionNumber    Int
  title            String
  content          String
  action           String           // CREATED, EDITED_DRAFT, PUBLISHED, ARCHIVED
  summaryOfChanges String
  previousStatus   String
  newStatus        String
  createdByName    String
  createdAt        DateTime         @default(now())

  article          KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, versionNumber])
  @@index([articleId])
}

// ----------------------------------------------------
// 6. INTEGRATION HEALTH, AUDIT & WEBHOOKS
// ----------------------------------------------------

model IntegrationHealthSnapshot {
  id                String            @id @default(cuid())
  integration       String            // sarvam_ai, daya_hms, telephony_ivr
  name              String
  status            String            // Connected, Connected (Demo Mode), Degraded, Down
  health            IntegrationHealth @default(HEALTHY)
  latencyMs         Int
  lastEventReceived DateTime?
  metadataJson      String?
  recordedAt        DateTime          @default(now())

  @@index([integration, recordedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // CALL, ACTION, KNOWLEDGE, USER, SETTINGS, AUTH
  entityId    String
  action      String   // LOGIN, LOGOUT, CREATED, UPDATED, PUBLISHED, DELETED, VERIFIED
  performedBy String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress   String?
  details     String?
  timestamp   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
}

model WebhookProcessingRecord {
  id              String        @id @default(cuid())
  provider        String        // sarvam, telephony, hms
  eventType       String        // call_ended, action_event, slot_update
  externalEventId String?       @unique
  idempotencyKey  String?       @unique
  payloadHash     String
  status          WebhookStatus @default(RECEIVED)
  retryCount      Int           @default(0)
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([provider, eventType])
  @@index([status])
  @@index([createdAt])
}

// ----------------------------------------------------
// 7. HOSPITAL ADMINISTRATION SETTINGS
// ----------------------------------------------------

model HospitalSetting {
  id                          String   @id @default("default_hospital_settings")
  retentionDays               String   @default("30")
  enableMalayalamConsent      Boolean  @default(true)
  strictMasking               Boolean  @default(true)
  defaultStaffRecordingAccess Boolean  @default(false)
  missedCallThreshold         Int      @default(30)
  urgentFollowUpAlerts        Boolean  @default(true)
  emergencyCasualtyAlerts     Boolean  @default(true)
  dailyDigestEmail            Boolean  @default(true)
  hmsTimeoutThresholdMs       Int      @default(3000)
  lastUpdatedBy               String?
  updatedAt                   DateTime @updatedAt
}

// ----------------------------------------------------
// 8. MULTI-HOSPITAL SAAS TENANTS
// ----------------------------------------------------

model Hospital {
  id                  String   @id
  name                String
  shortName           String
  city                String
  state               String
  status              String   @default("ACTIVE")
  telephonyProvider   String   @default("EXOTEL")
  exotelAccountSid    String?
  exotelApiKey        String?
  exotelAppId         String?
  exotelVirtualNumber String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
}

// ----------------------------------------------------
// 9. HOSPITAL CONFIGURATION & VERSIONING (PHASE 2)
// ----------------------------------------------------

model HospitalConfigDraft {
  id                            String   @id @default(cuid())
  hospitalId                    String   @unique
  displayName                   String?
  timezone                      String   @default("Asia/Kolkata")
  defaultLanguage               String   @default("ml-IN")
  supportedLanguages            String[] @default(["ml-IN", "en-IN"])
  
  // Telephony Configuration
  telephonyProvider             String   @default("EXOTEL")
  exotelAccountSid              String?
  exotelRegion                  String   @default("singapore")
  exotelSubdomain               String   @default("api.exotel.com")
  exotelApiKeyEncrypted         String?
  exotelApiTokenEncrypted       String?
  exotelDefaultExoPhone         String?
  exotelDefaultAppId            String?
  exotelWebhookSecretEncrypted   String?
  exotelStatusCallbackUrl       String?
  incomingVirtualNumbers        String[] @default([])
  transferDestinations          Json?
  emergencyDestinations         String[] @default(["+919606654032"])
  
  // AI Settings
  aiEnabled                     Boolean  @default(true)
  defaultSttModel               String   @default("saaras:v4")
  defaultLlmModel               String   @default("sarvam-105b-conversations")
  defaultTtsModel               String   @default("bulbul:v3")
  defaultSpeaker                String   @default("kavitha")
  defaultSpeakingPace           Float    @default(1.15)
  aiSilenceTimeoutMs            Int      @default(400)
  maxCallDurationSeconds        Int      @default(600)
  
  // Business Settings
  businessHours                 Json?
  afterHoursBehavior            String   @default("AI_VOICEBOT")
  emergencyEscalationPolicy     Json?
  
  lastUpdatedBy                 String
  updatedAt                     DateTime @updatedAt
  createdAt                     DateTime @default(now())

  @@index([hospitalId])
}

model HospitalConfigVersion {
  id                  String   @id @default(cuid())
  hospitalId          String
  versionNumber       Int
  isActive            Boolean  @default(false)
  changelog           String?
  publishedBy         String
  publishedAt         DateTime @default(now())
  
  // Complete Snapshot (JSON)
  configSnapshot      Json
  
  createdAt           DateTime @default(now())

  @@unique([hospitalId, versionNumber])
  @@index([hospitalId, isActive])
}

model ConfigAuditLog {
  id             String   @id @default(cuid())
  hospitalId     String
  entityType     String   // HOSPITAL_CONFIG, AI_AGENT, TELEPHONY_PROVIDER
  entityId       String
  action         String   // DRAFT_SAVED, PUBLISHED, ROLLED_BACK, CREDENTIALS_UPDATED
  performedBy    String
  userId         String?
  changesSummary String?
  oldValueJson   String?
  newValueJson   String?
  timestamp      DateTime @default(now())

  @@index([hospitalId, timestamp])
  @@index([entityType, entityId])
}

model DurableIdempotencyRecord {
  id              String   @id @default(cuid())
  hospitalId      String
  idempotencyKey  String
  resourceType    String   // OUTBOUND_CALL, AGENT_UPDATE, CONFIG_PUBLISH
  callSid         String?
  callId          String?
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  responseJson    String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([hospitalId, idempotencyKey])
  @@index([hospitalId, resourceType])
  @@index([expiresAt])
}

model DurableRateLimitBucket {
  id          String   @id @default(cuid())
  hospitalId  String
  bucketKey   String   // outbound_calls, voice_preview, agent_test
  count       Int      @default(1)
  windowStart DateTime @default(now())
  windowEnd   DateTime
  createdAt   DateTime @default(now())

  @@unique([hospitalId, bucketKey])
  @@index([hospitalId, windowEnd])
}

// ----------------------------------------------------
// 10. AI AGENTS (PHASE 3)
// ----------------------------------------------------

enum AgentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DISABLED
}

model AiAgent {
  id                      String       @id @default(cuid())
  hospitalId              String
  name                    String
  description             String?
  purpose                 String       // RECEPTIONIST, APPOINTMENT_BOOKING, DEPARTMENT_ENQUIRY, AFTER_HOURS, OUTBOUND_REMINDER
  status                  AgentStatus  @default(DRAFT)
  isDefault               Boolean      @default(false)
  currentVersion          Int          @default(1)
  
  // Model & Voice Config
  sttModel                String       @default("saaras:v4")
  llmModel                String       @default("sarvam-105b-conversations")
  ttsModel                String       @default("bulbul:v3")
  speaker                 String       @default("kavitha")
  speakingPace            Float        @default(1.15)
  defaultLanguage         String       @default("ml-IN")
  supportedLanguages      String[]     @default(["ml-IN", "en-IN"])
  
  // Conversation & Prompt Config
  greetingMalayalam       String       @default("നമസ്കാരം, ദയ ഹോസ്പിറ്റലിലേക്ക് സ്വാഗതം. ഞാൻ ദയ എഐ അസിസ്റ്റന്റാണ്. എനിക്ക് എങ്ങനെ സഹായിക്കാനാകും?")
  greetingEnglish         String       @default("Hello, welcome to Daya Hospital. I am the AI assistant. How may I help you today?")
  systemPrompt            String
  promptSections          Json?
  personalityTone         String       @default("EMPATHETIC_PROFESSIONAL")
  responseLength          String       @default("CONCISE")
  languageSwitchMode      String       @default("AUTO_DETECT")
  humanHandoffInstruction String?
  
  // Call Timing & Behaviour
  maxDurationSeconds      Int          @default(600)
  silenceTimeoutMs        Int          @default(400)
  noInputBehavior         String       @default("PROMPT_AGAIN")
  fallbackBehavior        String       @default("TRANSFER_CASUALTY")
  
  lastUpdatedBy           String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  versions                AiAgentVersion[]

  @@index([hospitalId, status])
  @@index([hospitalId, purpose])
}

model AiAgentVersion {
  id                  String       @id @default(cuid())
  agentId             String
  versionNumber       Int
  status              AgentStatus  @default(PUBLISHED)
  changelog           String?
  snapshotJson        Json
  publishedBy         String
  publishedAt         DateTime     @default(now())

  agent               AiAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, versionNumber])
  @@index([agentId, versionNumber])
}

// ----------------------------------------------------
// 11. INBOUND CALL FLOWS & VISUAL IVR (PHASE 4)
// ----------------------------------------------------

enum IvrFlowStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
}

enum ExotelDeploymentStatus {
  SMRKOMED_DRAFT
  VALIDATED
  PUBLISHED_INTERNALLY
  EXOTEL_MAPPING_REQUIRED
  EXOTEL_MAPPING_VERIFIED
  ACTIVE
}

model IvrFlow {
  id                   String                 @id @default(cuid())
  hospitalId           String
  name                 String
  description          String?
  status               IvrFlowStatus          @default(DRAFT)
  deploymentStatus     ExotelDeploymentStatus @default(SMRKOMED_DRAFT)
  isDefault            Boolean                @default(false)
  currentVersion       Int                    @default(1)
  
  // Multi-tenant Flow Orchestration (Phase 4.6)
  category             String                 @default("INBOUND_RECEPTION") // INBOUND_RECEPTION, EMERGENCY_ESCALATION, DEPARTMENT_ROUTING, AFTER_HOURS, APPOINTMENT, BILLING_INSURANCE, HUMAN_HANDOFF, LAB_ENQUIRIES, DOCTOR_INFO, CUSTOM
  direction            String                 @default("INBOUND") // INBOUND, OUTBOUND
  executionPriority    Int                    @default(100) // 1000 for emergency, 100 for standard
  triggerConditions    Json?                  // e.g. { intent: "EMERGENCY" }, { afterHours: true }
  isEnabled            Boolean                @default(true)
  isTemplate           Boolean                @default(false)
  templateCategory     String?
  
  // Graph Data
  nodesJson            Json                   // Array<FlowNode>
  edgesJson            Json                   // Array<FlowEdge>
  variablesJson        Json?                  // Flow-level settings, timeout, fallback rules
  
  // Exotel Provider Mapping
  exotelAppletId       String?
  exotelAppletName     String?
  exotelEndpointUrl    String?
  exotelVerifiedAt     DateTime?
  
  lastUpdatedBy        String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  versions             IvrFlowVersion[]
  executionSessions    IvrFlowExecutionSession[]

  @@index([hospitalId, status])
  @@index([hospitalId, isDefault])
  @@index([hospitalId, category])
  @@index([isTemplate])
}

model IvrFlowVersion {
  id                   String                 @id @default(cuid())
  flowId               String
  versionNumber        Int
  status               IvrFlowStatus          @default(PUBLISHED)
  deploymentStatus     ExotelDeploymentStatus @default(PUBLISHED_INTERNALLY)
  changelog            String?
  snapshotJson         Json                   // Immutable snapshot of nodes, edges, variables
  publishedBy          String
  publishedAt          DateTime               @default(now())

  flow                 IvrFlow                @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, versionNumber])
  @@index([flowId, versionNumber])
}

model IvrFlowExecutionSession {
  id                   String                 @id @default(cuid())
  flowId               String
  versionNumber        Int
  callSid              String?
  callerNumber         String?
  hospitalId           String
  currentNodeId        String
  variables            Json?
  status               String                 @default("ACTIVE") // ACTIVE, COMPLETED, TRANSFERRED, FAILED, EMERGENCY_INTERRUPTED
  executionLog         Json                   // Array of transition logs
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  flow                 IvrFlow                @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, versionNumber])
  @@index([callSid])
  @@index([hospitalId, status])
}

// ----------------------------------------------------
// 12. MULTI-TENANT ORCHESTRATION & EMERGENCY (PHASE 4.6)
// ----------------------------------------------------

model EmergencyEvent {
  id                   String                 @id @default(cuid())
  hospitalId           String
  callSid              String
  flowId               String
  flowVersion          Int
  triggerPhrase        String
  confidenceScore      Float                  @default(1.0)
  detectedLanguage     String                 @default("ml-IN")
  targetDestination    String
  transferOutcome      String                 @default("INITIATED") // INITIATED, CONNECTED, FAILED, FALLBACK_EXPLAINED, SIMULATED
  fallbackAction       String?
  callerNumber         String?
  createdAt            DateTime               @default(now())
  resolvedAt           DateTime?

  @@index([hospitalId, createdAt])
  @@index([callSid])
}

model EmergencyRoutingConfig {
  id                            String   @id @default(cuid())
  hospitalId                    String   @unique
  casualtyNumber                String   @default("100")
  isVerified                    Boolean  @default(false)
  verifiedBy                    String?
  verifiedAt                    DateTime?
  fallbackNumber                String?
  allowLiveTransfer             Boolean  @default(false) // Safety: default false until explicitly confirmed
  interruptionKeywordsMalayalam String[] @default([])
  interruptionKeywordsEnglish   String[] @default([])
  interruptionKeywordsManglish  String[] @default([])
  confidenceThreshold           Float    @default(0.7)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([hospitalId])
}

model FlowInvocation {
  id                   String                 @id @default(cuid())
  sessionCallSid       String
  parentFlowId         String
  childFlowId          String
  childFlowVersion     Int
  callDepth            Int                    @default(1)
  invokedFromNodeId    String
  status               String                 @default("ACTIVE") // ACTIVE, RETURNED, INTERRUPTED_EMERGENCY, FAILED
  returnValue          Json?
  createdAt            DateTime               @default(now())
  returnedAt           DateTime?

  @@index([sessionCallSid])
  @@index([parentFlowId])
  @@index([childFlowId])
}

model FlowAuditEvent {
  id                   String                 @id @default(cuid())
  hospitalId           String
  flowId               String
  flowVersion          Int?
  action               String                 // CREATED, EDITED, CLONED, TESTED, PUBLISHED, DISABLED, ARCHIVED, ROLLED_BACK
  actor                String
  details              Json?
  createdAt            DateTime               @default(now())

  @@index([hospitalId, flowId])
  @@index([hospitalId, createdAt])
}

// ----------------------------------------------------
// 12. STAFF & RECEPTIONIST PRESENCE (HUMAN-FIRST ROUTING)
// ----------------------------------------------------

model StaffPresence {
  id                  String                 @id @default(cuid())
  hospitalId          String
  userId              String
  staffName           String
  extension           String?
  phoneNumber         String?
  status              StaffPresenceStatus    @default(OFFLINE)
  currentCallSid      String?
  assignedAt          DateTime?
  ringStartedAt       DateTime?
  callAnsweredAt      DateTime?
  lastStatusChangeAt  DateTime               @default(now())
  callsHandledToday   Int                    @default(0)
  missedCallsToday    Int                    @default(0)
  metadata            Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  auditLogs           StaffPresenceAuditLog[]

  @@unique([hospitalId, userId])
  @@index([hospitalId, status])
  @@index([hospitalId, currentCallSid])
}

model StaffPresenceAuditLog {
  id                  String                 @id @default(cuid())
  hospitalId          String
  staffPresenceId     String
  userId              String
  previousStatus      StaffPresenceStatus
  newStatus           StaffPresenceStatus
  reason              String
  callSid             String?
  actor               String                 @default("SYSTEM")
  details             Json?
  timestamp           DateTime               @default(now())

  staffPresence       StaffPresence          @relation(fields: [staffPresenceId], references: [id], onDelete: Cascade)

  @@index([hospitalId, staffPresenceId])
  @@index([hospitalId, timestamp])
  @@index([callSid])
}

// ----------------------------------------------------
// 13. AI OVERFLOW LOGS & TELEPHONY ANALYTICS (PHASE B)
// ----------------------------------------------------

enum AiOverflowReason {
  RECEPTIONIST_BUSY
  RING_TIMEOUT
  RECEPTIONIST_OFFLINE
  RECEPTIONIST_BREAK
  NO_STAFF_CONFIGURED
  CONCURRENCY_CONFLICT
  MANUAL_OVERFLOW
}

model AiOverflowLog {
  id                  String             @id @default(cuid())
  hospitalId          String
  callSid             String
  callerNumber        String
  dialedNumber        String?
  reason              AiOverflowReason
  targetStaffUserId   String?
  targetStaffName     String?
  ringDurationSeconds Int?
  handledByAi         Boolean            @default(true)
  context             Json?
  timestamp           DateTime           @default(now())

  @@index([hospitalId, timestamp])
  @@index([callSid])
  @@index([reason])
}
