datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  HOSPITAL_ADMIN
  CALL_REVIEWER
}

enum CallStatus {
  ANSWERED
  BUSY
  MISSED
  TRANSFERRED
  FAILED
}

enum CallSource {
  IVR_ROLLOVER
  DIRECT_HOTLINE
  OFF_HOURS
}

enum CallLanguage {
  MALAYALAM
  MANGLISH
  ENGLISH
}

enum IntentCategory {
  APPOINTMENT_BOOKING
  DOCTOR_AVAILABILITY
  DEPARTMENT_ENQUIRY
  CONSULTATION_FEES
  HOSPITAL_TIMINGS
  EMERGENCY_AMBULANCE
  INSURANCE_TPA
  GENERAL_QUERY
}

enum FollowUpStatus {
  NOT_REQUIRED
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum ActionStatus {
  REQUESTED
  IN_PROGRESS
  CONFIRMED
  FAILED
  PENDING_VERIFICATION
  REQUIRES_STAFF_FOLLOW_UP
  CANCELLED
}

enum ActionType {
  CHECK_DOCTOR_SLOT
  BOOK_APPOINTMENT
  RESCHEDULE_APPOINTMENT
  CANCEL_APPOINTMENT
  TRANSFER_CALL_TO_STAFF
  FEE_ENQUIRY
  DEPARTMENT_ROUTING
}

enum KnowledgeStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       UserRole @default(CALL_REVIEWER)
  department String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CallRecord {
  id                String         @id
  externalCallId    String         @unique
  callerNumber      String
  callerName        String?
  startTime         DateTime
  endTime           DateTime
  durationSeconds   Int
  callStatus        CallStatus     @default(ANSWERED)
  callSource        CallSource     @default(IVR_ROLLOVER)
  language          CallLanguage   @default(MALAYALAM)
  intentCategory    IntentCategory @default(GENERAL_QUERY)
  aiSummary         String
  aiConfidence      Float          @default(0.95)
  requiresFollowUp  Boolean        @default(false)
  followUpStatus    FollowUpStatus @default(NOT_REQUIRED)
  followUpNotes     String?
  assignedStaff     String?
  hmsTransactionRef String?
  recordingUrl      String?
  transcriptJson    String? // Stored as serialized JSON
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  actions           AiAction[]

  @@index([callerNumber])
  @@index([callStatus])
  @@index([intentCategory])
  @@index([startTime])
}

model AiAction {
  id              String       @id
  callId          String
  callerNumber    String
  callerName      String?
  actionType      ActionType
  status          ActionStatus @default(REQUESTED)
  idempotencyKey  String       @unique
  requestedAt     DateTime     @default(now())
  completedAt     DateTime?
  hmsBookingRef   String?
  doctorName      String?
  department      String?
  appointmentSlot String?
  patientUhid     String?
  patientName     String?
  failureReason   String?
  staffNotes      String?
  payloadJson     String? // Serialized request payload
  responseJson    String? // Serialized response payload
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  call            CallRecord   @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([status])
  @@index([idempotencyKey])
}

model KnowledgeArticle {
  id                String          @id
  title             String
  titleMalayalam    String
  category          String
  summary           String
  content           String
  contentMalayalam  String
  status            KnowledgeStatus @default(PUBLISHED)
  version           Int             @default(1)
  lastUpdatedBy     String
  updatedAt         DateTime        @updatedAt
  syncedToSarvam    Boolean         @default(false)
  lastSyncedAt      DateTime?
  auditHistoryJson  String? // Serialized audit trail
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  performedBy String
  details     String?
  timestamp   DateTime @default(now())
}
